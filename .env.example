GEMINI_API_KEY=
XAI_API_KEY=
GEMINI_MODEL=gemini-4-argon
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
# Avaliação cruzada às cegas: python -m lab --eval --cross-judge (Gemini↔Grok; não usa estas linhas).
# Terceiro juiz (opcional): python -m lab --eval --judge — tem de ser outro modelo que os dois em teste.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash
# Opcional. Sem isto, não se envia teto de tokens na resposta.
# MAX_OUTPUT_TOKENS=
# Chat web (python -m uvicorn lab.app:app --reload --port 8000): gemini ou xai.
CHAT_PROVIDER=xai
# Avaliações humanas: Firestore (Firebase / Google Cloud). No Cloud Run basta o projeto e a ADC.
FIREBASE_PROJECT_ID=
# FIRESTORE_DATABASE=(default)
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\conta-de-servico.json
# Emulador local: FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Só testes: HUMAN_EVAL_STORE=memory
